# Three checks a day (Madrid time). Persistent: if the machine was off at a scheduled time, it runs at boot.
[Unit]
Description=flight-radar: price check 3 times a day

[Timer]
OnCalendar=*-*-* 09:20:00 Europe/Madrid
OnCalendar=*-*-* 15:20:00 Europe/Madrid
OnCalendar=*-*-* 20:40:00 Europe/Madrid
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
