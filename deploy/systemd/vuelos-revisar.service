# Una revisión de precios. Plantilla: scripts/install_systemd.sh sustituye __DIR__ y __USER__.
[Unit]
Description=vuelos-baratos: revisión de precios
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStart="__DIR__/.venv/bin/python" -m vuelos revisar
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
