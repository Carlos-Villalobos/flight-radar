# One price check. Template: scripts/install_systemd.sh replaces __DIR__ and __USER__.
[Unit]
Description=flight-radar: price check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStart="__DIR__/.venv/bin/python" -m flight_radar check
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
