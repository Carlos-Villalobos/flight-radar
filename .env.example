# Copy as .env (once) and fill in. Never committed to git.

# Gmail account that receives the Google Flights alerts. Use an APP PASSWORD (revocable), never the account
# password. Mail is read in read-only mode: nothing is marked, moved or deleted.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Telegram bot and chat for the notifications. The agent only SENDS messages (sendMessage) and never reads the
# bot (getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: another folder for the SQLite database (default ./data)
FLIGHT_RADAR_DATA=
