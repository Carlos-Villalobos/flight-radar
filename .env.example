# Copiar como .env (solo una vez) y completar. Nunca se sube a git. Se puede partir del .env de job-radar.

# Gmail donde llegan las alertas de Google Flights. Contraseña de APLICACIÓN (revocable), no la de la cuenta.
# Se lee en modo solo lectura: no marca, mueve ni borra correos.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Telegram: este agente solo ENVÍA mensajes (sendMessage) y nunca lee el bot (getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: otra carpeta para la base SQLite (por defecto ./data)
VUELOS_DATA=
